parameters:
  level: 8
  # The DBAL decorators must compile against both doctrine/dbal 3 and 4, whose
  # driver interfaces have incompatible signatures. The version-specific code is
  # guarded at runtime; reportUnmatchedIgnoredErrors is disabled so the inline
  # ignores work whichever major version is installed in CI.
  reportUnmatchedIgnoredErrors: false
  excludePaths:
    # Analysis runs against doctrine/dbal 4, where DBAL3\Connection's bool-returning
    # transaction methods are not covariant with the void parent signatures (a
    # non-ignorable error). That class is only ever loaded under doctrine/dbal 3;
    # the dbal 4 Connection and the shared ConnectionTrait are analysed normally.
    - src/Tracing/Doctrine/Instrumentation/DBAL/DBAL3/Connection.php
